<Page
    x:Class="TimeTrackingStudio.WinUI.Views.ClientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TimeTrackingStudio.WinUI.Models"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Directorio de Clientes" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Gestión comercial, tarifas horarias pactadas y seguimiento de facturación" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Click="OnNewClientClicked" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Nuevo Cliente" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Barra de Búsqueda -->
        <Grid Grid.Row="1">
            <TextBox Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Buscar por nombre, empresa o correo electrónico..."
                     MaxWidth="500" HorizontalAlignment="Left">
                <TextBox.Header>
                    <TextBlock Text="Filtro de búsqueda" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </TextBox.Header>
            </TextBox>
        </Grid>

        <!-- Lista de Clientes -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <ListView ItemsSource="{x:Bind ViewModel.Clients, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Client">
                        <Grid Padding="8,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Nombre y Empresa -->
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="{x:Bind Company}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Email}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <!-- Teléfono y Notas -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Phone}" FontSize="12" />
                                <TextBlock Text="{x:Bind Notes}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>

                            <!-- Tarifa Pactada -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Tarifa Base" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind DisplayRate}" FontWeight="SemiBold" FontSize="13" Foreground="#0078D4" />
                            </StackPanel>

                            <!-- Total Facturado -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="Total Facturado" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind TotalEarned}" FontWeight="Bold" FontSize="14" Foreground="#107C41" />
                            </StackPanel>

                            <!-- Botones de Acción -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="OnEditClientClicked" Tag="{x:Bind}" ToolTipService.ToolTip="Editar información de cliente">
                                    <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                </Button>
                                <Button Click="OnDeleteClientClicked" Tag="{x:Bind}" ToolTipService.ToolTip="Eliminar cliente">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#D13438" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
