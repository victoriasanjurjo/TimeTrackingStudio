<Page
    x:Class="TimeTrackingStudio.WinUI.Views.JobsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TimeTrackingStudio.WinUI.Models"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Control de Trabajos y Tareas" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Seguimiento de estados de entrega, prioridades, avance y horas invertidas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Click="OnNewJobClicked" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Nuevo Trabajo" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Filtros y Búsqueda -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Selector de Estado -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Filtrar por Estado:" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="FilterStatusComboBox" SelectionChanged="OnStatusFilterChanged" SelectedIndex="0">
                    <ComboBoxItem Content="Todos" />
                    <ComboBoxItem Content="Pendiente" />
                    <ComboBoxItem Content="En progreso" />
                    <ComboBoxItem Content="En revisión" />
                    <ComboBoxItem Content="Entregado" />
                    <ComboBoxItem Content="Facturado" />
                </ComboBox>
            </StackPanel>

            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Buscar por título de tarea o cliente..."
                     MaxWidth="400" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- Tabla / Lista de Trabajos -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <ListView ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Job">
                        <Grid Padding="8,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Tarea y Cliente -->
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{x:Bind ClientName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>

                            <!-- Prioridad -->
                            <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="6,2" CornerRadius="8" Background="{x:Bind Priority, Converter={StaticResource PriorityToBrushConverter}}">
                                <TextBlock Text="{x:Bind Priority}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                            </Border>

                            <!-- Horas y Avance -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind LoggedHours}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="/" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind EstimatedHours}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="h" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ProgressBar Value="{x:Bind ProgressPercentage}" Maximum="100" />
                            </StackPanel>

                            <!-- Fecha Límite -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="Fecha Límite" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind DueDate}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>

                            <!-- Selector Rápido de Estado -->
                            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border Padding="8,4" CornerRadius="12" Background="{x:Bind Status, Converter={StaticResource StatusToBrushConverter}}">
                                    <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Border>
                            </StackPanel>

                            <!-- Acciones -->
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="OnEditJobClicked" Tag="{x:Bind}" ToolTipService.ToolTip="Editar trabajo">
                                    <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                </Button>
                                <Button Click="OnDeleteJobClicked" Tag="{x:Bind}" ToolTipService.ToolTip="Eliminar trabajo">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#D13438" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
