<Page
    x:Class="TimeTrackingStudio.WinUI.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TimeTrackingStudio.WinUI.Models"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0">
            <StackPanel Spacing="4">
                <TextBlock Text="Informes Ejecutivos y Exportación" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Generación de documentos ejecutivos y exportación de datos a la carpeta outputs/" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Botones de Acción y Exportación -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="24">
                    <StackPanel Spacing="2">
                        <TextBlock Text="HORAS ANALIZADAS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalHours, Mode=OneWay}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="MONTO FACTURABLE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalEarnings, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#107C41" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="TOTAL REGISTROS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalEntries, Mode=OneWay}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.ExportCsvCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B9;" FontSize="13" />
                            <TextBlock Text="Exportar a CSV" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ExportHtmlCommand}" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C3;" FontSize="13" />
                            <TextBlock Text="Generar Informe HTML" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mensaje de estado -->
        <InfoBar Grid.Row="2" x:Name="NotificationInfoBar" IsOpen="False" Severity="Success" />

        <!-- Vista Previa de Datos -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <ListView ItemsSource="{x:Bind ViewModel.ReportLogs, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TimeLog">
                        <Grid Padding="8,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind ClientName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind JobTitle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind StartTime}" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock Grid.Column="3" Text="{x:Bind FormattedDuration}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Amount}" FontWeight="Bold" Foreground="#107C41" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
