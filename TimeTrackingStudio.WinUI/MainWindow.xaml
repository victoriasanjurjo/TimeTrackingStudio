<Window
    x:Class="TimeTrackingStudio.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TimeTrackingStudio.WinUI.Models"
    Title="Time Tracking Studio"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Barra Superior Persistente: Cronómetro Global -->
            <RowDefinition Height="Auto" />
            <!-- Cuerpo Principal con NavigationView -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra Superior Persistente: Cronómetro en Vivo -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Identidad y Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#0078D4" Width="36" Height="36" CornerRadius="8">
                        <FontIcon Glyph="&#xE823;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Time Tracking Studio" FontWeight="Bold" FontSize="15" />
                        <TextBlock Text="100% Local &amp; Privado" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Selectores de Cliente, Tarea y Descripción -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Selector de Cliente -->
                    <ComboBox x:Name="ClientsCombo" ItemsSource="{x:Bind ViewModel.Clients, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedClient, Mode=TwoWay}"
                              DisplayMemberPath="Name" PlaceholderText="Selecciona Cliente..."
                              MinWidth="180" VerticalAlignment="Center" />

                    <!-- Selector de Trabajo -->
                    <ComboBox x:Name="JobsCombo" ItemsSource="{x:Bind ViewModel.AvailableJobs, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedJob, Mode=TwoWay}"
                              DisplayMemberPath="Title" PlaceholderText="Selecciona Trabajo / Proyecto..."
                              MinWidth="220" VerticalAlignment="Center" />

                    <!-- Descripción rápida de actividad -->
                    <TextBox Text="{x:Bind ViewModel.TimerDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="¿En qué estás trabajando ahora?"
                             MinWidth="240" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Display Digital y Botones de Control -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Contador Digital -->
                    <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="6" Padding="12,4">
                        <TextBlock Text="{x:Bind ViewModel.TimerDisplay, Mode=OneWay}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center" />
                    </Border>

                    <!-- Botón Iniciar (visible cuando está detenido) -->
                    <Button x:Name="StartButton" Command="{x:Bind ViewModel.StartTimerCommand}" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Iniciar cronómetro">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Iniciar" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Pausar -->
                    <Button x:Name="PauseButton" Command="{x:Bind ViewModel.PauseTimerCommand}" ToolTipService.ToolTip="Pausar cronómetro">
                        <FontIcon Glyph="&#xE769;" FontSize="14" />
                    </Button>

                    <!-- Botón Reanudar -->
                    <Button x:Name="ResumeButton" Command="{x:Bind ViewModel.ResumeTimerCommand}" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Reanudar cronómetro">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                    </Button>

                    <!-- Botón Detener y Guardar -->
                    <Button x:Name="StopButton" Command="{x:Bind ViewModel.StopTimerCommand}" ToolTipService.ToolTip="Guardar sesión trabajada">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71A;" Foreground="#107C41" FontSize="14" />
                            <TextBlock Text="Guardar" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Descartar -->
                    <Button x:Name="DiscardButton" Command="{x:Bind ViewModel.DiscardTimerCommand}" ToolTipService.ToolTip="Descartar tiempo sin guardar">
                        <FontIcon Glyph="&#xE74D;" Foreground="#D13438" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- NavigationView y Contenido -->
        <NavigationView Grid.Row="1" x:Name="NavView" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Panel de Control" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Clientes" Tag="Clients">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE779;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Trabajos y Tareas" Tag="Jobs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Hoja de Tiempos" Tag="Timesheet">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Informes y Exportación" Tag="Reports">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
